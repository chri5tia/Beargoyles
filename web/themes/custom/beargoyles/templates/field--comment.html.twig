{#
/**
 * @file
 * Default theme override for comment fields.
 *
 * @see template_preprocess_field()
 * @see comment_preprocess_field()
 */
#}
<section{{ attributes.addClass('beargoyles-comments') }}>

  {% if comments %}
    <div class="beargoyles-comments__chatbox">
      {{ comments }}
    </div>
  {% endif %}

  {% if comment_form %}
    <div class="beargoyles-comments__form">
      {{ comment_form }}
    </div>
  {% endif %}

</section>
