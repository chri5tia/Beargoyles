<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_taxonomy_term_form_alter().
 */
function beargoyles_helper_form_taxonomy_term_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  $form['relations']['parent']['#type'] = 'radios';

  foreach ($form['relations']['parent']['#options'] as $key => $label) {
    if (str_starts_with((string) $label, '-')) {
      $form['relations']['parent']['#options'][$key] =
        '↳ ' . ltrim((string) $label, '-');
    }
  }

  $form['relations']['parent']['#element_validate'][] =
    'beargoyles_helper_parent_validate';

  $form['relations']['parent']['#attributes']['class'][] =
    'beargoyles-parent-options';

  $form['#attached']['library'][] = 'beargoyles_helper/admin';
}

/**
 * Converts the radio value to the array taxonomy expects.
 */
function beargoyles_helper_parent_validate(
  array &$element,
  FormStateInterface $form_state,
  array &$complete_form,
): void {
  $value = $form_state->getValue('parent');

  $form_state->setValue('parent', [$value]);
}

/**
 * Implements hook_page_attachments_alter().
 */
function beargoyles_helper_page_attachments_alter(array &$attachments): void {
  $request = \Drupal::request();

  if ($request->query->has('page')) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'robots',
          'content' => 'noindex, follow',
        ],
      ],
      'beargoyles_pager_noindex',
    ];
  }
}
